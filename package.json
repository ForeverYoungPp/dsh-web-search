{
  "name": "@ian_p/dsh-web-search",
  "version": "0.1.5-rc.3",
  "description": "Multi-provider third-party web search for the DeepSeek Harness: routes the native web_search tool through a configurable provider fallback chain, with an isolated provider settings page.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README_ZH.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForeverYoungPp/dsh-web-search.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.3",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node tests/host-core.test.mjs && node tests/interaction.test.mjs && echo OK",
    "test:rpc": "node tests/remote-contract.test.mjs && node tests/client-bundle.smoke.mjs && echo OK",
    "typecheck": "tsc -p tsconfig.types.json",
    "prepublishOnly": "npm run build && npm test && npm run test:rpc && npm run typecheck"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.1.5-rc.3",
    "react": "^18.2.0",
    "typescript": "^7.0.2"
  }
}
